# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

BUKMACHERKA_DATABASE_URL=sqlite:///data/bukmacherka.db
BUKMACHERKA_LEAGUES=["E0", "SP1", "I1", "D1", "F1", "POL"]

BUKMACHERKA_TAX_RATE=0.12
BUKMACHERKA_MIN_EV=0.05
BUKMACHERKA_KELLY_FRACTION=0.25
BUKMACHERKA_MAX_STAKE_PCT=0.02

# Darmowe klucze:
# https://www.football-data.org/client/register
# https://dashboard.api-football.com/register
# https://the-odds-api.com/#get-access
BUKMACHERKA_FOOTBALL_DATA_ORG_KEY=
BUKMACHERKA_API_FOOTBALL_KEY=
BUKMACHERKA_ODDS_API_KEY=
